{
  "types": [
    {
      "type": "SEP-Panic",
      "match_re": "\\bsep\\b[ \\t]+(?:\\S+[ \\t]+)*\\bpanic\\b",
      "is_hardware": true,
      "suspected_hardware": "SEP chip or encrypted hardware components (Face ID / Touch ID module, encrypted Flash/NAND, NFC/Stockholm)",
      "components": "sep",
      "subtypes": [
        {
          "type": "SEP-SKS",
          "match": "SEP Panic: :sks",
          "is_hardware": true,
          "suspected_hardware": "NAND / Touch ID or Face ID flex / Board SPI",
          "components": "storage"
        },
        {
          "type": "SEP-ROM-BOOT",
          "match": "SEP ROM boot panic",
          "is_hardware": true,
          "suspected_hardware": "NAND / PMU",
          "components": "storage"
        }
      ]
    },
    {
      "type": "DCP-Panic",
      "match_re": "(?:\\bdcp\\b[ \\t]+(?:\\S+[ \\t]+)*\\bpanic\\b|\\bdcp\\b[ \\t]+crash)",
      "is_hardware": true,
      "suspected_hardware": "Display flex or screen assembly / Display IC / OLED Panel",
      "components": "display",
      "subtypes": [
        {
          "type": "DCP-HPD",
          "match": "No device added after powering on the rails. HPD=0",
          "is_hardware": true,
          "suspected_hardware": "USB-C Port / DP Output / HPD",
          "components": "display"
        },
        {
          "type": "DCP-PMIC",
          "match": "Panel Power On Sequence Timeout",
          "is_hardware": true,
          "suspected_hardware": "Display Flex Cable / Display Power IC (Display PMIC)",
          "components": "display"
        },
        {
          "type": "DCP-BUS",
          "match": "DCP MBOX Read Timeout",
          "is_hardware": true,
          "suspected_hardware": "DCP Communication Bus (Mailbox)",
          "components": "display"
        },
        {
          "type": "DCP-EDID",
          "match": "I2C/AUX Read Failure during EDID fetch",
          "is_hardware": true,
          "suspected_hardware": "USB-C AUX Path / Display EDID Chip",
          "components": "display"
        },
        {
          "type": "DCP-SETMODE",
          "match": "set_run_mode_safe",
          "is_hardware": true,
          "suspected_hardware": "OLED panel, flex cables, or connector pins",
          "components": "display"
        },
        {
          "type": "DCP-AUTOMODE-FAILED",
          "match": "auto_mode_change failed",
          "is_hardware": true,
          "suspected_hardware": "Screen ribbon cable / (PMU/Display Power Rail)",
          "components": "display"
        },
        {
          "type": "DCP-CRASH",
          "match": "DCP crash of unknown type",
          "is_hardware": true,
          "suspected_hardware": "Screen/Flex Cable/Display Power Supply IC",
          "components": "display"
        },
        {
          "type": "DCP-RCA",
          "match": "RCA, turning cpu on when its already booted",
          "is_hardware": true,
          "suspected_hardware": "Display PMIC",
          "components": "display"
        }
      ]
    },
    {
      "type": "AOP-Panic",
      "match": "AOP PANIC - ",
      "is_hardware": true,
      "suspected_hardware": "Always-On Processor: sensor co-processor (SCM) i2c bus failure",
      "components": "board",
      "subtypes": [
        {
          "type": "AOP-SCM-BMP284",
          "scope": "body",
          "match": "BMP284",
          "suspected_hardware": "Barometric pressure sensor (BMP284)",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2cscm0",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cscm0[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Power & Battery Subsystem",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2cscm1",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cscm1[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Front Display & Motion Sensors",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2cscm2",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cscm2[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Thermal & Capacitive Touch",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2cscm3",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cscm3[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Audio & Haptics / Secondary PMU",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2cscm4",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cscm4[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "USB-C / Dock Connector",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2csm0",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2csm0[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "PMU / fuel gauge / Tristar / Hydra charging control chip.",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2csm1",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2csm1[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Proximity / ambient light sensor (ALS) / TrueDepth dot projector",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2csm2",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2csm2[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Multi-channel NTC thermistor / wireless charging receiver IC.",
          "components": "board"
        },
        {
          "type": "AOP-SCM-i2csm3",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2csm3[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Taptic Engine / audio amplifier",
          "components": "board"
        },        
        {
          "type": "AOP-SCM-i2cm0",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cm0[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "screen touch / camera module EEPROMs",
          "components": "board"
        },        
        {
          "type": "AOP-SCM-i2cm1",
          "scope": "body",
          "match_re": "SCMController[ \\t]+i2cm1[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "screen touch / camera module EEPROMs",
          "components": "board"
        },
        {
          "type": "AOP-SCM-{1}",
          "scope": "body",
          "match_re": "SCMController[ \\t]+(\\S+)[ \\t]+\\[[^\\]]*\\][ \\t]*:[ \\t]*global-errors[ \\t]*=[ \\t]*[1-9][0-9]*",
          "suspected_hardware": "Low power sensors & Flex Cable / sensor bus failure",
          "components": "board"
        }
      ]
    },
    {
      "type": "Userspace-Panic",
      "match_re": "userspace[ \\t]+(?:panic|watchdog[ \\t]+timeout)",
      "is_hardware": false,
      "note": "Software-related userspace panic (daemon/migrator hang or watchdog timeout); not a hardware fault — do not replace components.",
      "subtypes": [
        {
          "type": "Userspace-NAND-Panic",
          "match": "userspace panic: boot task failure",
          "is_hardware": true,
          "suspected_hardware": "NAND Flash failure (boot task finish-obliteration/fsck exited abnormally)",
          "components": "storage"
        }
      ]
    },
    {
      "type": "Watchdog-Panic",
      "match_re": "watchdog[ \\t]+reset",
      "is_hardware": true,
      "suspected_hardware": "SoC watchdog reset — power management / supply rails",
      "components": "battery"
    },
    {
      "type": "PMGR-Panic",
      "match": "pmgr",
      "is_hardware": true,
      "suspected_hardware": "Power manager (ApplePMGR) deadline failure — board-level power circuit",
      "components": "board"
    },
    {
      "type": "Kernel-Panic",
      "match_re": "kern[ea]l[ \\t]+data[ \\t]+abort",
      "is_hardware": false,
      "note": "Software-related panic (kernel data abort); not a hardware fault — do not replace components."
    },
    {
      "type": "Halt-Panic",
      "match_re": "halt/restart[ \\t]+timed[ \\t]+out",
      "is_hardware": true,
      "suspected_hardware": "Halt/restart timed out — dock flex and USB communication circuit.",
      "components": "charging",
      "subtypes": [
        {
          "type": "Halt-Panic-13",
          "match_re": "halt/restart[ \\t]+timed[ \\t]+out",
          "is_hardware": true,
          "architectures": ["ARCH_IPHONE_13"],
          "suspected_hardware": "Charge Flex / BMS cable / Rear Microphone / Flash flex",
          "components": "charging"
        },
        {
          "type": "Halt-Panic-14",
          "match_re": "halt/restart[ \\t]+timed[ \\t]+out",
          "is_hardware": true,
          "architectures": ["ARCH_IPHONE_14", "ARCH_IPHONE_14_PRO"],
          "suspected_hardware": "Charge Flex / BMS cable / Wireless Charging Flex.",
          "components": "charging"
        },
        {
          "type": "Halt-Panic-15",
          "match_re": "halt/restart[ \\t]+timed[ \\t]+out",
          "is_hardware": true,
          "architectures": ["ARCH_IPHONE_15", "ARCH_IPHONE_15_PRO"],
          "suspected_hardware": "USB-C Flex / BMS cable / thermal_sensor.",
          "components": "charging"
        },
        {
          "type": "Halt-Panic-16-17",
          "match_re": "halt/restart[ \\t]+timed[ \\t]+out",
          "is_hardware": true,
          "architectures": ["ARCH_IPHONE_16_17"],
          "suspected_hardware": "USB-C Flex / PMU / Multi-point thermistor.",
          "components": "charging"
        }
      ]
    },
    {
      "type": "PORT-Fail-Panic",
      "match_re": "port[ \\t]+enable[ \\t]+failed",
      "is_hardware": true,
      "suspected_hardware": "Baseband or Wi-Fi/BT combo chip (port enable failure)",
      "components": "rf"
    },
    {
      "type": "I2C-Panic",
      "match_re": "\\bi2c\\d*\\b",
      "is_hardware": true,
      "suspected_hardware": "I2C bus fault with a display-related target (display-pmu / display-eeprom / mogul-display) — display power rail or flex",
      "components": "display",
      "subtypes": [
        {
          "type": "I2C-Audio-Panic",
          "match": "ad5860",
          "is_hardware": true,
          "suspected_hardware": "I2C bus fault targeting the audio codec (ad5860) — audio circuit",
          "components": "audio"
        },
        {
          "type": "I2C-Display-Panic",
          "match": "mogul",
          "is_hardware": true,
          "suspected_hardware": "Display and Touch Certification Module",
          "components": "display"
        },
        {
          "type": "I2C-Display-PMU-Panic",
          "match": "display-pmu",
          "is_hardware": true,
          "suspected_hardware": "Display assembly / display flex cable / PMU",
          "components": "display"
        },
        {
          "type": "I2C-Display-EEPROM-Panic",
          "match": "display-eeprom",
          "is_hardware": true,
          "suspected_hardware": "Display EEPROM — display power rail or flex",
          "components": "display"
        }
      ]
    },
    {
      "type": "General-Panic",
      "fallback": true,
      "scope": "body",
      "is_hardware": false,
      "note": "Unclassified panic — no known hardware attribution from the panic header. Add body-keyword subtypes here to map it to hardware.",
      "subtypes": [
        {
          "type": "monotonic",
          "match": "Non-monotonic",
          "is_hardware": true,
          "suspected_hardware": "Monotonic timer failure",
          "components": "display"
        }
      ]
    }
  ]
}
